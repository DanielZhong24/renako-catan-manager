# Discord application and bot credentials
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
DISCORD_TOKEN=your_discord_bot_token

# OAuth2 callback configuration for local development
# Register REDIRECT_URI in the Discord Developer Portal.
DISCORD_AUTH_URL=https://discord.com/oauth2/authorize?client_id=your_discord_application_id&response_type=code&redirect_uri=http%3A%2F%2Flocalhost%3A3000%2Fapi%2Fauth%2Fcallback&scope=identify
REDIRECT_URI=http://localhost:3000/api/auth/callback

# URL used in links sent by the Discord bot
API_BASE_URL=http://localhost:3000

# Optional browser extension ID
EXTENSION_ID=your_browser_extension_id

# Optional bot-to-API URL. Docker uses http://api:3000 by default.
INTERNAL_API_URL=http://api:3000

# PostgreSQL settings
DB_USER=user
DB_PASSWORD=password
DB_NAME=catan_db

# pgAdmin login
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# Optional settings for running services outside Docker
# PORT=3000
# ADMIN_COOKIE_SECURE=false
